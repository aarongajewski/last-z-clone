{
  "name": "last-z-clone",
  "private": true,
  "version": "0.3.0",
  "description": "Browser-based clone of Last Z: Survival Shooter, built for iPhone Safari / Home Screen.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "art": "node scripts/import-kenney.mjs",
    "smoke": "node scripts/smoke-check.mjs",
    "bot": "node scripts/autoplay.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
